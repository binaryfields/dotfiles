// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  // Theme
  "theme": "Base16 Zenburn Mod",
  "buffer_font_family": "Monaco", // Zed Plex Mono", // "CommitMono Nerd Font",
  "buffer_font_size": 16.0,
  "buffer_line_height": "standard",
  "markdown_preview_font_size": 20.0,
  "ui_font_size": 16.0,
  "ui_font_weight": 500.0,
  "agent_ui_font_size": 16.0,

  // UI
  "cursor_blink": false,
  "cursor_shape": "bar",
  "gutter": {
    "line_numbers": true,
    "runnables": false,
    "breakpoints": false,
    "folds": false,
    "min_line_number_digits": 0,
  },
  "indent_guides": {
    "coloring": "indent_aware",
  },
  "project_panel": {
    "dock": "left",
    "indent_size": 16,
    "hide_root": true,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "git_status": true,
    "show_diagnostics": "errors",
  },
  "toolbar": {
    "quick_actions": false,
    "breadcrumbs": false,
  },
  "scrollbar": {
    "show": "auto",
    "diagnostics": "all",
  },

  // Editing
  "inlay_hints": {
    "enabled": true,
  },
  "preferred_line_length": 90,
  "tab_size": 4,
  "format_on_save": "off",
  "remove_trailing_whitespace_on_save": true,
  "edit_predictions": {
    "provider": "none"
  },

  // Telemetry
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },

  // Theme Overrides
  "experimental.theme_overrides": {
    "syntax": {
      "error": {
        "color": "#FF0000",
        "font_weight": 900,
      },
      "warning": {
        "color": "#FFFF00",
        "font_weight": 900,
      },
    },
  },
}

[core]
    editor = zed --wait
    pager = delta

[alias]
    # Common aliases for productivity
    s = status
    co = checkout
    cb = checkout -b
    cm = commit -m
    ca = commit --amend
    p = push
    pl = pull
    l = log --oneline --graph --all
    lg = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
    d = diff
    ds = diff --staged
    rb = rebase -i
    st = stash
    sp = stash pop
    cl = clone
    # Undo last commit but keep changes
    undo = reset --soft HEAD~1

[delta]
    syntax-theme = Dracula
    line-numbers = true
    navigate = true

[user]
    name = Sebastian Jastrzebski
    email = sebby2k@gmail.com

[core]
    editor = zed --wait
    pager = delta

[init]
    defaultBranch = main

[commit]
    verbose = true

[pull]
    rebase = true

[push]
    default = simple
    autoSetupRemote = true

[merge]
    conflictstyle = diff3
    ff = only

[rebase]
    autoStash = true
    autosquash = true

[fetch]
    prune = true

[color]
    ui = auto

[diff]
    algorithm = histogram
    renames = true

[alias]
    # Common aliases for productivity
    s = status
    co = checkout
    cb = checkout -b
    cm = commit -m
    ca = commit --amend
    p = push
    pl = pull
    l = log --oneline --graph --all
    lg = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
    d = diff
    ds = diff --staged
    rb = rebase -i
    st = stash
    sp = stash pop
    cl = clone
    # Undo last commit but keep changes
    undo = reset --soft HEAD~1

[gpg]
    program = gpg

[credential]
    # Use a credential helper to cache credentials
    helper = cache --timeout=3600  # Cache for 1 hour
    # For macOS: helper = osxkeychain
    # For Windows: helper = wincred

[http]
    version = HTTP/2

[protocol]
    version = 2

[delta]
    syntax-theme = Dracula
    line-numbers = true
    navigate = true
